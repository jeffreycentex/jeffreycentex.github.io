---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PostCard from '../components/PostCard.astro';
import { getPosts } from '../lib/blog';
import { getProjects } from '../lib/docs';
import { site } from '../data/site';
const posts = (await getPosts()).slice(0, 3);
const projects = await getProjects();
const focus = [
  { icon: 'pulse', title: 'Healthcare Informatics', text: 'Veradigm EHR/PM pipelines, HL7 interfaces, Unity and FHIR APIs, SSRS and SSMS applications.' },
  { icon: 'shield', title: 'Security', text: 'EDR/XDR, endpoint protection, API design, and practical lessons from running security in a mid-sized medical practice.' },
  { icon: 'radio', title: 'Radio & SDRs', text: 'All things digital (HF/VHF), KiwiSDR, ADS-B, packet radio, APRS, MeshCore and Meshtastic. Member of the 65th Communications Group, Air Force MARS.' },
];
---
<Base>
  <section class="hero">
    <div class="wrap hero-inner">
      <div>
        <p class="eyebrow">{site.callsign} · New Braunfels, Texas</p>
        <h1><span class="grad">Systems, signals,</span><br />and the space between.</h1>
        <p class="lede">I'm Jeff Randow: a healthcare IT developer, Georgia Tech instructional associate, and amateur radio operator who builds tools for patients' data and for the HF bands.</p>
        <div class="btn-row">
          <a class="btn btn-primary" href="/blog/">Read the blog <Icon name="arrow" size={18} /></a>
          <a class="btn" href="/projects/">Projects</a>
          <a class="btn" href="/about/">About me</a>
        </div>
        <div class="stats">
          <div><strong>13+ yrs</strong>Healthcare IT</div>
          <div><strong>10 yrs</strong>Teaching at Georgia Tech</div>
          <div><strong>Air Force MARS · CERT</strong>Emergency communications</div>
        </div>
      </div>
      <div class="portrait">
        <img src="/img/headshot-400.webp" srcset="/img/headshot-400.webp 400w, /img/headshot-800.webp 800w" sizes="(max-width: 820px) 220px, 360px" width="400" height="400" alt="Portrait of Jeff Randow" fetchpriority="high" />
      </div>
    </div>
  </section>

  <div class="wrap">
    <section class="section">
      <div class="grid">
        {focus.map((f) => (
          <div class="card"><span class="icon"><Icon name={f.icon} size={28} /></span><h3>{f.title}</h3><p>{f.text}</p></div>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="section-head"><h2>Featured projects</h2><a href="/projects/">All projects →</a></div>
      <div class="grid">
        {projects.map((p) => (
          <a class="card" href={`/projects/${p.id}/`}>
            <h3>{p.data.title}</h3><p>{p.data.tagline}</p>
            <div class="chips">{p.data.tags.map((t) => <span class="chip">{t}</span>)}</div>
          </a>
        ))}
      </div>
    </section>

    {posts.length > 0 && (
      <section class="section">
        <div class="section-head"><h2>Latest posts</h2><a href="/blog/">All posts →</a></div>
        <div class="grid">{posts.map((post) => <PostCard post={post} />)}</div>
      </section>
    )}

    <section class="section">
      <div class="section-head"><h2>Radio library</h2><a href="/docs/">Browse docs →</a></div>
      <div class="grid">
        <a class="card" href={site.kiwi} rel="noopener"><h3>Listen live: my KiwiSDR</h3><p>A public shortwave receiver in New Braunfels. Open it in any browser.</p></a>
        <a class="card" href="/docs/hf-digital-modes/"><h3>HF digital modes</h3><p>Getting started with FT8, JS8Call, PSK and more over HF.</p></a>
        <a class="card" href="/docs/air-force-mars/"><h3>Air Force MARS</h3><p>What Air Force MARS is, how to join, and how traffic moves.</p></a>
        <a class="card" href="/docs/new-braunfels-cert/"><h3>New Braunfels CERT</h3><p>Community Emergency Response Team: what it is and how to get involved.</p></a>
        <a class="card" href="/docs/emcomm/"><h3>EMCOMM</h3><p>Texas RACES, SkyWARN, Winlink, fldigi nets and mesh networking.</p></a>
      </div>
    </section>
  </div>
</Base>
