---
import Base from '../../../layouts/Base.astro';
import PostCard from '../../../components/PostCard.astro';
import { getPosts, slugify } from '../../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = new Map<string, string>();
  posts.forEach((p) => p.data.tags.forEach((t) => tags.set(slugify(t), t)));
  return [...tags].map(([slug, name]) => ({
    params: { tag: slug },
    props: { name, posts: posts.filter((p) => p.data.tags.some((t) => slugify(t) === slug)) },
  }));
}
const { name, posts } = Astro.props;
---
<Base title={`#${name}`} description={`Blog posts tagged ${name}.`}>
  <div class="wrap">
    <div class="page-head"><p class="eyebrow">Tag</p><h1>#{name}</h1><p><a href="/blog/">← All posts</a></p></div>
    <div class="grid" style="margin-top:2rem">{posts.map((p) => <PostCard post={p} />)}</div>
  </div>
</Base>
