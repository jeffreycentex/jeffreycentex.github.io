---
import Base from '../../../layouts/Base.astro';
import PostCard from '../../../components/PostCard.astro';
import { getPosts, categories, slugify } from '../../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPosts();
  return categories.map((c) => ({
    params: { category: slugify(c) },
    props: { name: c, posts: posts.filter((p) => p.data.category === c) },
  }));
}
const { name, posts } = Astro.props;
---
<Base title={`${name} posts`} description={`Blog posts in ${name}.`}>
  <div class="wrap">
    <div class="page-head">
      <p class="eyebrow">Category</p>
      <h1>{name}</h1>
      <div class="chips"><a class="chip" href="/blog/">All</a>{categories.map((c) => <a class={`chip${c === name ? ' active' : ''}`} href={`/blog/category/${slugify(c)}/`}>{c}</a>)}</div>
    </div>
    {posts.length === 0 ? <p class="muted" style="margin-top:2rem">Nothing here yet.</p> : <div class="grid" style="margin-top:2rem">{posts.map((p) => <PostCard post={p} />)}</div>}
  </div>
</Base>
