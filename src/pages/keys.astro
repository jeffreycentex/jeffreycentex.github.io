---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
---
<Base title="Keys" description="Public PGP key, Signal handle and verified identities for Jeff Randow (N5SNT).">
  <div class="wrap">
    <div class="page-head">
      <p class="eyebrow">Digital keys</p>
      <h1>Verify me. Write to me securely.</h1>
      <p>Encrypted email and signed commits are welcome. I publish more than one key, one per address I use. Always compare a fingerprint with a second source before trusting a key.</p>
    </div>

    <div class="grid" style="margin-top:2rem;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr))">
      {site.keys.map((k) => (
        <section class="card">
          <span class="icon"><Icon name="key" size={28} /></span>
          <h3>PGP key: {k.label}</h3>
          <dl class="kv">
            <dt>Key ID</dt><dd class="mono">{k.id}</dd>
            <dt>Email</dt><dd class="mono">{k.emails.join(', ')}</dd>
            <dt>Created</dt><dd>{k.created}</dd>
          </dl>
          <div class="fp"><code data-fp>{k.fingerprint}</code><button class="btn copy" type="button">Copy</button></div>
          <div class="btn-row" style="margin-top:.5rem"><a class="btn btn-primary" href={k.file} download><Icon name="download" size={18} /> Download .asc</a></div>
          <pre class="mono muted" style="margin:.75rem 0 0;font-size:.82rem">gpg --import {k.file.split('/').pop()}</pre>
        </section>
      ))}

      <section class="card">
        <span class="icon"><Icon name="signal" size={28} /></span>
        <h3>Signal</h3>
        <p>Preferred for quick, private messages. Signal or Threema are better than SMS/RCS.</p>
        <dl class="kv"><dt>Username</dt><dd class="mono">{site.signal}</dd></dl>
      </section>

      <section class="card">
        <span class="icon"><Icon name="shield" size={28} /></span>
        <h3>Security contact</h3>
        <p>Found a vulnerability on this site or one of my projects? Email me, ideally encrypted. Machine-readable details are in <a href="/.well-known/security.txt">security.txt</a>.</p>
      </section>

      <section class="card">
        <span class="icon"><Icon name="github" size={28} /></span>
        <h3>Other identities</h3>
        <ul style="margin:0;padding-left:1.2rem;color:var(--muted)">
          <li><a href="https://github.com/jeffreycentex">GitHub</a></li>
          <li><a rel="me" href="https://mastodon.radio/@jeffreycentex">Mastodon</a></li>
          <li><a href="https://x.com/jeffreycentex">X (Twitter)</a></li>
          <li><a href="https://www.linkedin.com/in/jeffreyrandow">LinkedIn</a></li>
        </ul>
      </section>
    </div>
  </div>
</Base>
<script>
  document.querySelectorAll<HTMLButtonElement>('button.copy').forEach((b) => {
    b.addEventListener('click', async () => {
      const t = b.parentElement?.querySelector('[data-fp]')?.textContent?.replace(/\s+/g, '') ?? '';
      try { await navigator.clipboard.writeText(t); b.textContent = 'Copied'; } catch { b.textContent = 'Press ⌘/Ctrl+C'; }
      setTimeout(() => (b.textContent = 'Copy'), 1800);
    });
  });
</script>
