---
import Base from '../layouts/Base.astro';
---
<Base title="Search" description="Search blog posts and documentation.">
  <div class="wrap">
    <div class="page-head"><p class="eyebrow">Search</p><h1>Find something.</h1></div>
    <div id="search" style="margin-top:1.5rem;max-width:900px"></div>
    <p id="search-note" class="muted" hidden>Search index is generated by <code>npm run build</code>; it isn't available in the dev server.</p>
  </div>
</Base>
<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
<script is:inline src="/pagefind/pagefind-ui.js" onerror="document.getElementById('search-note').hidden=false"></script>
<script is:inline>
  window.addEventListener('DOMContentLoaded', () => {
    if (window.PagefindUI) new PagefindUI({ element: '#search', showSubResults: true, autofocus: true });
  });
</script>
